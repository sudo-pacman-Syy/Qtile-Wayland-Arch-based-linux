{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/my_art.txt",
        "padding": {
            "top": 2,
            "right": 4 }
    },
    "display": {
        "separator": " ➔ ",
        "color": {
            "keys": "magenta" }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "──────────────────────────────"
        },
        {
            "type": "os",
            "key": "OS   "
        },
        {
            "type": "kernel",
            "key": "KER  "
        },
        {
            "type": "uptime",
            "key": "Time Work   "
        },
        {
            "type": "custom",
            "format": "──────────────────────────────"
        },
        {
            "type": "wm",
            "key": "WM   "
        },
        {
            "type": "terminal",
            "key": "TERM "
        },
        {
            "type": "shell",
            "key": "SH   "
        },
        {
            "type": "custom",
            "format": "──────────────────────────────"
        },
        {
            "type": "memory",
            "key": "RAM  "
        },
        {
            "type": "colours",
            "symbol": "colors"
        }
    ]
}
